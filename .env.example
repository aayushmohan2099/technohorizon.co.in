# Techno Horizon Corporate Web Portal — Environment Configuration Example
# Copy this file to .env.local for local overrides.
# NOTE: Never store production credentials or private API keys in client-accessible variables.

VITE_SITE_URL=https://www.technohorizon.co.in
VITE_CONTACT_EMAIL=contact@technohorizon.co.in

# Optional Enterprise Backend Endpoint (for automated CRM/Tender dispatch)
# When left unset, forms use client-side URL-encoded mailto draft generation with clipboard copy fallback.
# VITE_LEAD_DISPATCH_ENDPOINT=https://api.technohorizon.co.in/v1/intake
